// Sample 3: Global Value Numbering (GVN) & Common Subexpression Elimination
// Replaces repeated subexpressions (a + b) with single evaluation across basic blocks.

int a = 4;
int b = 7;
int res1 = a + b;
int res2 = b + a;
int res3 = (a + b) * 2;
int res4 = (b + a) * 2;

if (res1 > 10) {
    int check1 = a + b;
    print(check1);
} else {
    int check2 = b + a;
    print(check2);
}

print(res1, res2, res3, res4);
